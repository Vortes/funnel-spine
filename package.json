{
  "name": "funnel-spine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/react/atlas-funnel.d.ts",
      "default": "./dist/react/atlas-funnel.js"
    }
  },
  "files": [
    "dist/react/atlas-funnel.js",
    "dist/react/atlas-funnel.js.map",
    "dist/react/*.d.ts",
    "docs/react-chart-architecture.md",
    "docs/react-integration.md",
    "docs/launch-readiness.md"
  ],
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:lab": "node scripts/build-lab.mjs",
    "build:package": "node scripts/build-package.mjs",
    "check": "npm run build:package && npm run build:lab && node verify.mjs && node verify-lab.mjs && node verify-particles.mjs && node verify-chart-model.mjs && node verify-react-screens.mjs && node verify-react.mjs && node verify-lab-ui.mjs && npm run typecheck",
    "typecheck": "tsc --noEmit",
    "test": "npm run check"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dialkit": "^2.0.2",
    "esbuild": "^0.25.12",
    "jsdom": "^26.1.0",
    "motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
